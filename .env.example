# =============================================================================
# MEHR API — copy to .env and fill the secrets. Never commit .env.
# =============================================================================

# --- App ---
PORT=4000
CLIENT_URL=http://localhost:5173
ADMIN_EMAIL=sohailbrohi048@gmail.com

# --- Secrets: database ---
MONGODB_URI=mongodb://user:password@host:port/mehr?directConnection=true&authSource=admin

# --- Secrets: auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Secrets: S3-compatible media ---
S3_ENDPOINT=http://s3-example.sslip.io
S3_REGION=us-east-1
S3_BUCKET=your-bucket
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://s3-example.sslip.io/your-bucket

# --- Secrets: email (Gmail app password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MEHR <your-gmail@gmail.com>

# --- Secrets: optional chat LLM ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
